def effectivePrivilege (t : (AccessType Unit)) (m : (BitVec 64)) (priv : Privilege) : SailM Privilege := do
  if (Bool.and (bne t (Execute ())) (BEq.beq (_get_Mstatus_MPRV m) (0b1 : (BitVec 1))))
  then (privLevel_of_bits (_get_Mstatus_MPP m))
  else (pure priv)

