def pmpReadCfgReg (n : Nat) : SailM (BitVec (2 ^ 3 * 8)) := do
  assert (BEq.beq (emod_int n 2) 0) "Unexpected pmp config reg read"
  (pure (Sail.BitVec.append' (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 7))
      (Sail.BitVec.append' (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 6))
        (Sail.BitVec.append' (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 5))
          (Sail.BitVec.append' (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 4))
            (Sail.BitVec.append' (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 3))
              (Sail.BitVec.append'
                (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 2))
                (Sail.BitVec.append'
                  (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 1))
                  (vectorAccess (← readReg pmpcfg_n) (HAdd.hAdd (HMul.hMul n 4) 0))))))))))

/-- Type quantifiers: n : Nat, 0 ≤ n ∧ n ≤ 63 -/
def pmpReadAddrReg (n : Nat) : SailM (BitVec (2 ^ 3 * 8)) := do
  let G := (sys_pmp_grain ())
  let match_type ← do (pure (_get_Pmpcfg_ent_A (vectorAccess (← readReg pmpcfg_n) n)))
  let addr ← do (pure (vectorAccess (← readReg pmpaddr_n) n))
  match (BitVec.access match_type 1) with
  | 1#1 =>
    if (GE.ge G 2)
    then let mask : xlenbits := (zero_extend (ones))
         (pure (HOr.hOr addr mask))
    else (pure addr)
  | 0#1 =>
    if (GE.ge G 1)
    then let mask : xlenbits := (zero_extend (ones))
         (pure (HAnd.hAnd addr (Complement.complement mask)))
    else (pure addr)
  | _ => (pure addr)

def pmpLocked (cfg : (BitVec 8)) : Bool :=
  (BEq.beq (_get_Pmpcfg_ent_L cfg) (0b1 : (BitVec 1)))

def pmpTORLocked (cfg : (BitVec 8)) : Bool :=
  (Bool.and (BEq.beq (_get_Pmpcfg_ent_L cfg) (0b1 : (BitVec 1)))
    (BEq.beq (pmpAddrMatchType_of_bits (_get_Pmpcfg_ent_A cfg)) TOR))

/-- Type quantifiers: n : Nat, 0 ≤ n ∧ n ≤ 63 -/
def pmpWriteCfg (n : Nat) (cfg : (BitVec 8)) (v : (BitVec 8)) : (BitVec 8) :=
  if (pmpLocked cfg)
  then cfg
  else let cfg := (Mk_Pmpcfg_ent (HAnd.hAnd v (0x9F : (BitVec 8))))
       let cfg :=
         if (Bool.and (BEq.beq (_get_Pmpcfg_ent_W cfg) (0b1 : (BitVec 1)))
              (BEq.beq (_get_Pmpcfg_ent_R cfg) (0b0 : (BitVec 1))))
         then (_update_Pmpcfg_ent_X
                (_update_Pmpcfg_ent_W (_update_Pmpcfg_ent_R cfg (0b0 : (BitVec 1)))
                  (0b0 : (BitVec 1))) (0b0 : (BitVec 1)))
         else cfg
       if (Bool.and (GE.ge (sys_pmp_grain ()) 1)
            (BEq.beq (pmpAddrMatchType_of_bits (_get_Pmpcfg_ent_A cfg)) NA4))
       then (_update_Pmpcfg_ent_A cfg (pmpAddrMatchType_to_bits OFF))
       else cfg

/-- Type quantifiers: n : Nat, 0 ≤ n ∧ n ≤ 15 -/
def pmpWriteCfgReg (n : Nat) (v : (BitVec (2 ^ 3 * 8))) : SailM Unit := do
  assert (BEq.beq (emod_int n 2) 0) "Unexpected pmp config reg write"
  let loop_i_lower := 0
  let loop_i_upper := 7
  foreach_M loop_i_lower loop_i_upper 1 ()
    (λ i _ => do
      let idx := (HAdd.hAdd (HMul.hMul n 4) i)
      writeReg pmpcfg_n (vectorUpdate (← readReg pmpcfg_n) idx
        (pmpWriteCfg idx (vectorAccess (← readReg pmpcfg_n) idx)
          (Sail.BitVec.extractLsbUnif v (HAdd.hAdd (HMul.hMul 8 i) 7) (HMul.hMul 8 i)))))

