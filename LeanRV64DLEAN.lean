def process_vsseg (nf : Nat) (vm : (BitVec 1)) (vs3 : (BitVec 5)) (load_width_bytes : Nat) (rs1 : (BitVec 5)) (EMUL_pow : Int) (num_elem : Nat) : SailM Retired := do
