           (foreach_ME (cont (loop_j_lower)) (cont (loop_j_upper)) (cont (1)) ()
             (λ j _ => do
               let elem_offset := (HMul.hMul (HAdd.hAdd (HMul.hMul i nf) j) load_width_bytes)
               match (← (ext_data_get_addr rs1 (to_bits xlen elem_offset) (Write Data)
                   load_width_bytes)) with
               | .Ext_DataAddr_Error e =>
                 (pure (early_return
                     (let _ := (ext_handle_data_check_error e)
