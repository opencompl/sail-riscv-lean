                      | .TR_Failure (e, _) =>
                        (pure (early_return
                            (handle_mem_exception vaddr e)
                            RETIRE_FAIL))
                      | .TR_Address (paddr, _) =>
                        let eares : (MemoryOpResult Unit) ← do
                          (mem_write_ea paddr load_width_bytes false false false)
                        match eares with
                        | .Err e =>
                          (pure (early_return
                              (handle_mem_exception vaddr e)
                              RETIRE_FAIL))
                        | .Ok _ =>
                          let elem_val : (BitVec (load_width_bytes * 8)) ← do
                            (read_single_element (HMul.hMul load_width_bytes 8) i
                              (HAdd.hAdd vs3 (to_bits 5 (HMul.hMul j EMUL_reg))))
                          let res : (MemoryOpResult Bool) ← do
                            (mem_write_value paddr load_width_bytes elem_val false false false)
                          match res with
                          | .Ok true => (pure (cont (())))
                          | .Ok false =>
