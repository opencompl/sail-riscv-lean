def pmpMatchAddr (typ_0 : physaddr) (width : (BitVec (2 ^ 3 * 8))) (rng : (Option ((BitVec (2 ^ 3 * 8)) × (BitVec (2 ^ 3 * 8))))) : pmpAddrMatch :=
  let .physaddr addr := typ_0
  match rng with
  | none => PMP_NoMatch
  | .some (lo, hi) =>
    let addr := (BitVec.toNat addr)
    let width := (BitVec.toNat width)
    let lo := (HMul.hMul (BitVec.toNat lo) 4)
    let hi := (HMul.hMul (BitVec.toNat hi) 4)
    if (LE.le hi lo)
    then PMP_NoMatch
    else if (Bool.or (LE.le (HAdd.hAdd addr width) lo) (LE.le hi addr))
         then PMP_NoMatch
         else if (Bool.and (LE.le lo addr) (LE.le (HAdd.hAdd addr width) hi))
              then PMP_Match
              else PMP_PartialMatch

