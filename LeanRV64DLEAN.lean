  let vs3_seg : (Vector (BitVec (nf * load_width_bytes * 8)) num_elem) ← do
    (read_vreg_seg num_elem (HMul.hMul load_width_bytes 8) EMUL_pow nf vs3)
  let mask : (BitVec num_elem) ← do (init_masked_source num_elem EMUL_pow vm_val)
  let loop_i_lower := 0
