def calculate_new_vl (AVL : Int) (VLMAX : Int) : (BitVec (2 ^ 3 * 8)) :=
  let new_vl :=
    if (LE.le AVL VLMAX)
    then AVL
    else if (LT.lt AVL (HMul.hMul 2 VLMAX))
         then if (sys_vext_vl_use_ceil ())
              then (Int.tdiv (HAdd.hAdd AVL 1) 2)
              else VLMAX
         else VLMAX
  (to_bits xlen new_vl)

