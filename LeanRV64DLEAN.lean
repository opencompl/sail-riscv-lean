def freg_or_reg_name_backwards (arg_ : String) : SailM (BitVec 5) := do
  let head_exp_ := arg_
  match (← do
    let mapping0_ := head_exp_
    if (freg_name_backwards_matches mapping0_)
    then let reg ← do (freg_name_backwards mapping0_)
         if (sys_enable_fdext ())
         then (pure (some reg))
         else (pure none)
    else (pure none)) with
  | .some result => (pure result)
  | none =>
    match (← do
      let mapping1_ := head_exp_
      if (reg_name_backwards_matches mapping1_)
      then let reg ← do (reg_name_backwards mapping1_)
           if (sys_enable_zfinx ())
           then (pure (some reg))
           else (pure none)
      else (pure none)) with
    | .some result => (pure result)
    | _ =>
      assert false "Pattern match failure at unknown location"
      throw Error.Exit

