           (Bool.and (BEq.beq (HAdd.hAdd rs_int rs_group) (HAdd.hAdd rd_int rd_group))
             (GE.ge EMUL_pow_rs 0))))
  else if (GT.gt EMUL_pow_rs EMUL_pow_rd)
