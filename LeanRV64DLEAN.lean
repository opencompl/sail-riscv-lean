def fcvtmod_helper (x64 : (BitVec 64)) : ((BitVec 5) × (BitVec 32)) :=
  let (sign, exp, mant) := (fsplit_D x64)
  let is_subnorm := (Bool.and (BEq.beq exp (zeros_implicit)) (bne mant (zeros_implicit)))
  let is_zero := (Bool.and (BEq.beq exp (zeros_implicit)) (BEq.beq mant (zeros_implicit)))
  let is_nan_or_inf := (BEq.beq exp (ones))
  let true_mant := (Sail.BitVec.append' (0b1 : (BitVec 1)) mant)
  let true_exp := (HSub.hSub (BitVec.toNat exp) 1023)
  let is_too_large := (GE.ge true_exp 84)
  let is_too_small := (LT.lt true_exp 0)
  if is_zero
  then ((zeros_implicit), (zeros_implicit))
  else if is_subnorm
       then ((nxFlag ()), (zeros_implicit))
       else if is_nan_or_inf
            then ((nvFlag ()), (zeros_implicit))
            else if is_too_large
                 then ((nvFlag ()), (zeros_implicit))
                 else if is_too_small
                      then ((nxFlag ()), (zeros_implicit))
                      else let fixedpoint : (BitVec 84) := (shiftl (zero_extend true_mant) true_exp)
                           let integer := (Sail.BitVec.extractLsbUnif fixedpoint 83 52)
                           let fractional := (Sail.BitVec.extractLsbUnif fixedpoint 51 0)
                           let result :=
                             if (BEq.beq sign (0b1 : (BitVec 1)))
                             then (BitVec.addInt (Complement.complement integer) 1)
                             else integer
                           let max_integer :=
                             if (BEq.beq sign (0b1 : (BitVec 1)))
                             then (BitVec.toNat (0x80000000 : (BitVec 32)))
                             else (BitVec.toNat (0x7FFFFFFF : (BitVec 32)))
                           let flags : (BitVec 5) :=
                             if (GT.gt true_exp 31)
                             then (nvFlag ())
                             else if (GT.gt (BitVec.toNat integer) max_integer)
                                  then (nvFlag ())
                                  else if (bne fractional (zeros_implicit))
                                       then (nxFlag ())
                                       else (zeros_implicit)
                           (flags, result)

