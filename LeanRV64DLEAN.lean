/-- Type quantifiers: num_elem_vs : Nat, SEW : Nat, LMUL_pow : Int, num_elem_vs > 0 ∧
  SEW ∈ {8, 16, 32, 64} -/
def process_rfvv_single (funct6 : rfvvfunct6) (vm : (BitVec 1)) (vs2 : (BitVec 5)) (vs1 : (BitVec 5)) (vd : (BitVec 5)) (num_elem_vs : Nat) (SEW : Nat) (LMUL_pow : Int) : SailM Retired := do
  let rm_3b ← do (pure (_get_Fcsr_FRM (← readReg fcsr)))
  let num_elem_vd ← do (get_num_elem 0 SEW)
  if (← (illegal_fp_reduction SEW rm_3b))
  then (handle_illegal ())
       (pure RETIRE_FAIL)
  else assert (bne SEW 8) "riscv_insts_vext_fp_red.sail:35.17-35.18"
       if (BEq.beq (BitVec.toNat (← readReg vl)) 0)
       then (pure RETIRE_SUCCESS)
       else let n := num_elem_vs
            let d := num_elem_vd
            let m := SEW
            let vm_val : (BitVec n) ← do (read_vmask num_elem_vs vm (0b00000 : (BitVec 5)))
            let vd_val : (Vector (BitVec m) d) ← do (read_vreg num_elem_vd SEW 0 vd)
            let vs2_val : (Vector (BitVec m) n) ← do (read_vreg num_elem_vs SEW LMUL_pow vs2)
            let mask : (BitVec n) ← do (init_masked_source num_elem_vs LMUL_pow vm_val)
            let sum : (BitVec m) ← do (read_single_element SEW 0 vs1)
            let sum : (BitVec m) ← do
              let loop_i_lower := 0
              let loop_i_upper := (HSub.hSub num_elem_vs 1)
              foreach_M loop_i_lower loop_i_upper 1 sum
                (λ i sum => do
                  if (BEq.beq (BitVec.access mask i) 1#1)
                  then match funct6 with
                       | FVV_VFREDOSUM => (fp_add rm_3b sum (vectorAccess vs2_val i))
                       | FVV_VFREDUSUM => (fp_add rm_3b sum (vectorAccess vs2_val i))
                       | FVV_VFREDMAX => (fp_max sum (vectorAccess vs2_val i))
                       | FVV_VFREDMIN => (fp_min sum (vectorAccess vs2_val i))
                       | _ =>
                         (internal_error "riscv_insts_vext_fp_red.sail" 57 "Widening op unexpected")
                  else (pure sum))
            (write_single_element SEW 0 vd sum)
            (set_vstart (zeros_implicit))
            (pure RETIRE_SUCCESS)

/-- Type quantifiers: num_elem_vs : Nat, SEW : Nat, LMUL_pow : Int, num_elem_vs > 0 ∧
  SEW ∈ {8, 16, 32, 64} -/
def process_rfvv_widen (funct6 : rfvvfunct6) (vm : (BitVec 1)) (vs2 : (BitVec 5)) (vs1 : (BitVec 5)) (vd : (BitVec 5)) (num_elem_vs : Nat) (SEW : Nat) (LMUL_pow : Int) : SailM Retired := do
  let rm_3b ← do (pure (_get_Fcsr_FRM (← readReg fcsr)))
  let SEW_widen := (HMul.hMul SEW 2)
  let LMUL_pow_widen := (HAdd.hAdd LMUL_pow 1)
  let num_elem_vd ← do (get_num_elem 0 SEW_widen)
  if (← (illegal_fp_reduction_widen SEW rm_3b SEW_widen LMUL_pow_widen))
  then (handle_illegal ())
       (pure RETIRE_FAIL)
  else assert (Bool.and (GE.ge SEW 16) (LE.le SEW_widen 64)) "riscv_insts_vext_fp_red.sail:77.36-77.37"
       if (BEq.beq (BitVec.toNat (← readReg vl)) 0)
       then (pure RETIRE_SUCCESS)
       else let n := num_elem_vs
            let d := num_elem_vd
            let m := SEW
            let o := SEW_widen
            let vm_val : (BitVec n) ← do (read_vmask num_elem_vs vm (0b00000 : (BitVec 5)))
            let vd_val : (Vector (BitVec o) d) ← do (read_vreg num_elem_vd SEW_widen 0 vd)
            let vs2_val : (Vector (BitVec m) n) ← do (read_vreg num_elem_vs SEW LMUL_pow vs2)
            let mask : (BitVec n) ← do (init_masked_source num_elem_vs LMUL_pow vm_val)
            let sum : (BitVec o) ← do (read_single_element SEW_widen 0 vs1)
            let sum : (BitVec o) ← do
              let loop_i_lower := 0
              let loop_i_upper := (HSub.hSub num_elem_vs 1)
              foreach_M loop_i_lower loop_i_upper 1 sum
                (λ i sum => do
                  if (BEq.beq (BitVec.access mask i) 1#1)
                  then (fp_add rm_3b sum (← (fp_widen (vectorAccess vs2_val i))))
                  else (pure sum))
            (write_single_element SEW_widen 0 vd sum)
            (set_vstart (zeros_implicit))
            (pure RETIRE_SUCCESS)

