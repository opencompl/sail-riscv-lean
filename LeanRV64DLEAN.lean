    (read_vreg_seg num_elem (HMul.hMul load_width_bytes 8) EMUL_pow nf vd)
  let tail_ag : agtype ← do (get_vtype_vta ())
  let (result, mask) ← do
    (init_masked_result num_elem (HMul.hMul (HMul.hMul nf load_width_bytes) 8) EMUL_pow vd_seg
      vm_val)
  let trimmed : Bool := false
  let trimmed : Bool ← do
    let loop_i_lower := 0
    let loop_i_upper := (HSub.hSub num_elem 1)
    catchEarlyReturn
    (foreach_ME loop_i_lower loop_i_upper 1 trimmed
      (λ i trimmed => do
