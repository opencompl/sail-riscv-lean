/-- Type quantifiers: num_elem : Nat, evl : Nat, num_elem ≥ 0 ∧ evl ≥ 0 -/
def process_vm (vd_or_vs3 : (BitVec 5)) (rs1 : (BitVec 5)) (num_elem : Nat) (evl : Nat) (op : vmlsop) : SailM Retired := do
  let width_type : word_width := BYTE
  let start_element ← do (get_start_element ())
  let vd_or_vs3_val : (Vector (BitVec 8) num_elem) ← do (read_vreg num_elem 8 0 vd_or_vs3)
  let loop_i_lower := start_element
  let loop_i_upper := (HSub.hSub num_elem 1)
  catchEarlyReturn
  (foreach_ME loop_i_lower loop_i_upper 1 ()
    (λ i _ => do
      if (LT.lt i evl)
      then (set_vstart (to_bits 16 i))
           if (BEq.beq op VLM)
           then match (← (ext_data_get_addr rs1 (to_bits xlen i) (Read Data) 1)) with
                | .Ext_DataAddr_Error e =>
                  (pure (early_return
                      (let _ := (ext_handle_data_check_error e)
                      RETIRE_FAIL : Retired)))
                | .Ext_DataAddr_OK vaddr =>
                  if (check_misaligned vaddr width_type)
                  then (pure (early_return
                           (handle_mem_exception vaddr (E_Load_Addr_Align ()))
                           RETIRE_FAIL))
                  else match (← (translateAddr vaddr (Read Data))) with
                       | .TR_Failure (e, _) =>
                         (pure (early_return
                             (handle_mem_exception vaddr e)
                             RETIRE_FAIL))
                       | .TR_Address (paddr, _) =>
                         match (← (mem_read (Read Data) paddr 1 false false false)) with
                         | .Ok elem =>
                           (pure (cont ((← (write_single_element 8 i vd_or_vs3 elem)))))
                         | .Err e =>
                           (pure (early_return
                               (handle_mem_exception vaddr e)
                               RETIRE_FAIL))
           else if (BEq.beq op VSM)
                then match (← (ext_data_get_addr rs1 (to_bits xlen i) (Write Data) 1)) with
                     | .Ext_DataAddr_Error e =>
                       (pure (early_return
                           (let _ := (ext_handle_data_check_error e)
                           RETIRE_FAIL : Retired)))
                     | .Ext_DataAddr_OK vaddr =>
                       if (check_misaligned vaddr width_type)
                       then (pure (early_return
                                (handle_mem_exception vaddr (E_SAMO_Addr_Align ()))
                                RETIRE_FAIL))
                       else match (← (translateAddr vaddr (Write Data))) with
                            | .TR_Failure (e, _) =>
                              (pure (early_return
                                  (handle_mem_exception vaddr e)
                                  RETIRE_FAIL))
                            | .TR_Address (paddr, _) =>
                              let eares : (MemoryOpResult Unit) ← do
                                (mem_write_ea paddr 1 false false false)
                              match eares with
                              | .Err e =>
                                (pure (early_return
                                    (handle_mem_exception vaddr e)
                                    RETIRE_FAIL))
                              | .Ok _ =>
                                let res : (MemoryOpResult Bool) ← do
                                  (mem_write_value paddr 1 (vectorAccess vd_or_vs3_val i) false
                                    false false)
                                match res with
                                | .Ok true => (pure (cont (())))
                                | .Ok false =>
                                  (pure (cont ((← (internal_error "riscv_insts_vext_mem.sail" 878
                                          "store got false from mem_write_value")))))
                                | .Err e =>
                                  (pure (early_return
                                      (handle_mem_exception vaddr e)
                                      RETIRE_FAIL))
                else (pure (cont (())))
      else (pure (cont (if (BEq.beq op VLM)
               then (write_single_element 8 i vd_or_vs3 (vectorAccess vd_or_vs3_val i))
               else (pure ()))))))
  (set_vstart (zeros_implicit))
  (pure RETIRE_SUCCESS)

