/-- Type quantifiers: nf : Nat, load_width_bytes : Nat, num_elem : Nat, EMUL_pow : Int, 0 < nf ∧
  nf ≤ 8 ∧ load_width_bytes ∈ {1, 2, 4, 8} ∧ num_elem > 0 -/
def process_vlseg (nf : Nat) (vm : (BitVec 1)) (vd : (BitVec 5)) (load_width_bytes : Nat) (rs1 : (BitVec 5)) (EMUL_pow : Int) (num_elem : Nat) : SailM Retired := do
  let EMUL_reg : Int :=
    if (LE.le EMUL_pow 0)
    then 1
    else ((2 ^ ·) EMUL_pow)
  let width_type : word_width := (size_bytes_backwards load_width_bytes)
  let vm_val : (BitVec num_elem) ← do (read_vmask num_elem vm (0b00000 : (BitVec 5)))
  let vd_seg : (Vector (BitVec (nf * load_width_bytes * 8)) num_elem) ← do
    (read_vreg_seg num_elem (HMul.hMul load_width_bytes 8) EMUL_pow nf vd)
  let (result, mask) ← do
    (init_masked_result num_elem (HMul.hMul (HMul.hMul nf load_width_bytes) 8) EMUL_pow vd_seg
      vm_val)
  let loop_i_lower := 0
  let loop_i_upper := (HSub.hSub num_elem 1)
  catchEarlyReturn
  (foreach_ME loop_i_lower loop_i_upper 1 ()
    (λ i _ => do
      if (BEq.beq (BitVec.access mask i) 1#1)
      then (set_vstart (to_bits 16 i))
           let loop_j_lower := 0
           let loop_j_upper := (HSub.hSub nf 1)
           catchEarlyReturn
           (foreach_ME (cont (loop_j_lower)) (cont (loop_j_upper)) (cont (1)) ()
             (λ j _ => do
               let elem_offset := (HMul.hMul (HAdd.hAdd (HMul.hMul i nf) j) load_width_bytes)
               match (← (ext_data_get_addr rs1 (to_bits xlen elem_offset) (Read Data)
                   load_width_bytes)) with
               | .Ext_DataAddr_Error e =>
                 (pure (early_return
                     (let _ := (ext_handle_data_check_error e)
                     RETIRE_FAIL : Retired)))
               | .Ext_DataAddr_OK vaddr =>
                 if (check_misaligned vaddr width_type)
                 then (pure (early_return
                          (handle_mem_exception vaddr (E_Load_Addr_Align ()))
                          RETIRE_FAIL))
                 else match (← (translateAddr vaddr (Read Data))) with
                      | .TR_Failure (e, _) =>
                        (pure (early_return
                            (handle_mem_exception vaddr e)
                            RETIRE_FAIL))
                      | .TR_Address (paddr, _) =>
                        match (← (mem_read (Read Data) paddr load_width_bytes false false false)) with
                        | .Ok elem =>
                          (pure (cont ((← (write_single_element (HMul.hMul load_width_bytes 8) i
                                  (HAdd.hAdd vd (to_bits 5 (HMul.hMul j EMUL_reg))) elem)))))
                        | .Err e =>
                          (pure (early_return
                              (handle_mem_exception vaddr e)
                              RETIRE_FAIL))))
      else (pure (cont (let loop_j_lower := 0
               let loop_j_upper := (HSub.hSub nf 1)
               foreach_ loop_j_lower loop_j_upper 1 ()
                 (λ j _ => do
                   let skipped_elem :=
                     (Sail.BitVec.extractLsbUnif
                       (shiftr (vectorAccess result i) (HMul.hMul (HMul.hMul j load_width_bytes) 8))
                       (HSub.hSub (HMul.hMul load_width_bytes 8) 1) 0)
                   (← (write_single_element (HMul.hMul load_width_bytes 8) i
                       (HAdd.hAdd vd (to_bits 5 (HMul.hMul j EMUL_reg))) skipped_elem))))))))
  (set_vstart (zeros_implicit))
  (pure RETIRE_SUCCESS)

