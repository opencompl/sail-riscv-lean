def tvec_addr (m : (BitVec (2 ^ 3 * 8))) (c : (BitVec (2 ^ 3 * 8))) : (Option (BitVec (2 ^ 3 * 8))) :=
  let base : xlenbits := (Sail.BitVec.append' (_get_Mtvec_Base m) (0b00 : (BitVec 2)))
  match (trapVectorMode_of_bits (_get_Mtvec_Mode m)) with
  | TV_Direct => (some base)
  | TV_Vector =>
    if (BEq.beq (_get_Mcause_IsInterrupt c) (0b1 : (BitVec 1)))
    then (some (HAdd.hAdd base (shiftl (zero_extend (_get_Mcause_Cause c)) 2)))
    else (some base)
  | TV_Reserved => none

