  (sbox_lookup x aes_sbox_fwd_table)

def aes_sbox_inv (x : (BitVec 8)) : (BitVec 8) :=
  (sbox_lookup x aes_sbox_inv_table)

def aes_subword_fwd (x : (BitVec 32)) : (BitVec 32) :=
  (Sail.BitVec.append' (aes_sbox_fwd (Sail.BitVec.extractLsbUnif x 31 24))
    (Sail.BitVec.append' (aes_sbox_fwd (Sail.BitVec.extractLsbUnif x 23 16))
      (Sail.BitVec.append' (aes_sbox_fwd (Sail.BitVec.extractLsbUnif x 15 8))
        (aes_sbox_fwd (Sail.BitVec.extractLsbUnif x 7 0)))))

