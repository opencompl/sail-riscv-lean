def freg_or_reg_name_forwards (arg_ : (BitVec 5)) : SailM String := do
  let reg := arg_
  if (sys_enable_fdext ())
  then (pure (freg_name_forwards reg))
  else if (sys_enable_zfinx ())
       then (pure (reg_name_forwards reg))
       else assert false "Pattern match failure at unknown location"
            throw Error.Exit

