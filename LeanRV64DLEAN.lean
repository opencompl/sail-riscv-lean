                      | .Ext_DataAddr_OK vaddr =>
                        if (check_misaligned vaddr width_type)
                        then if (BEq.beq i 0)
                             then (pure (early_return
                                      (handle_mem_exception vaddr (E_Load_Addr_Align ()))
                                      RETIRE_FAIL))
                             else (pure (cont (writeReg vl (to_bits xlen i)
                                      (pure (print_endline
                                          (HAppend.hAppend "CSR vl <- "
                                            (BitVec.toFormatted (← readReg vl)))))
                                      true)))
                        else match (← (translateAddr vaddr (Read Data))) with
                             | .TR_Failure (e, _) =>
                               if (BEq.beq i 0)
                               then (pure (early_return
                                        (handle_mem_exception vaddr e)
                                        RETIRE_FAIL))
                               else (pure (cont (writeReg vl (to_bits xlen i)
                                        (pure (print_endline
                                            (HAppend.hAppend "CSR vl <- "
                                              (BitVec.toFormatted (← readReg vl)))))
                                        true)))
                             | .TR_Address (paddr, _) =>
                               match (← (mem_read (Read Data) paddr load_width_bytes false false
                                   false)) with
                               | .Ok elem =>
                                 (pure (cont ((write_single_element (HMul.hMul load_width_bytes 8) i
                                       (HAdd.hAdd vd (to_bits 5 (HMul.hMul j EMUL_reg))) elem)
                                     trimmed)))
                               | .Err e =>
                                 if (BEq.beq i 0)
                                 then (pure (early_return
                                          (handle_mem_exception vaddr e)
                                          RETIRE_FAIL))
                                 else (pure (cont (writeReg vl (to_bits xlen i)
