  (internal_pick [Bare, Sv32, Sv39, Sv48, Sv57])

/-- Type quantifiers: arg_ : Nat, 0 ≤ arg_ ∧ arg_ ≤ 4 -/
def SATPMode_of_num (arg_ : Nat) : SATPMode :=
  match arg_ with
  | 0 => Bare
  | 1 => Sv32
  | 2 => Sv39
  | 3 => Sv48
  | _ => Sv57

def num_of_SATPMode (arg_ : SATPMode) : Int :=
  match arg_ with
  | Bare => 0
  | Sv32 => 1
  | Sv39 => 2
  | Sv48 => 3
  | Sv57 => 4

def satpMode_of_bits (a : Architecture) (m : (BitVec 4)) : (Option SATPMode) :=
  match (a, m) with
  | (g__0, b__0) =>
    if (BEq.beq b__0 (0x0 : (BitVec 4)))
    then (some Bare)
    else match (g__0, b__0) with
         | (RV32, b__0) =>
           if (BEq.beq b__0 (0x1 : (BitVec 4)))
           then (some Sv32)
           else match (RV32, b__0) with
                | (_, _) => none
         | (RV64, b__0) =>
           if (BEq.beq b__0 (0x8 : (BitVec 4)))
           then (some Sv39)
           else if (BEq.beq b__0 (0x9 : (BitVec 4)))
                then (some Sv48)
                else if (BEq.beq b__0 (0xA : (BitVec 4)))
                     then (some Sv57)
                     else match (RV64, b__0) with
                          | (_, _) => none
         | (_, _) => none

