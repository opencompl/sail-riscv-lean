/-- Type quantifiers: k_ex254977# : Bool -/
def fle_H (v1 : (BitVec 16)) (v2 : (BitVec 16)) (is_quiet : Bool) : (Bool × (BitVec 5)) :=
  let (s1, e1, m1) := (fsplit_H v1)
  let (s2, e2, m2) := (fsplit_H v2)
  let v1Is0 := (Bool.or (f_is_neg_zero_H v1) (f_is_pos_zero_H v1))
  let v2Is0 := (Bool.or (f_is_neg_zero_H v2) (f_is_pos_zero_H v2))
  let result : Bool :=
    if (Bool.and (BEq.beq s1 (0b0 : (BitVec 1))) (BEq.beq s2 (0b0 : (BitVec 1))))
    then if (BEq.beq e1 e2)
         then (LE.le (BitVec.toNat m1) (BitVec.toNat m2))
         else (LT.lt (BitVec.toNat e1) (BitVec.toNat e2))
    else if (Bool.and (BEq.beq s1 (0b0 : (BitVec 1))) (BEq.beq s2 (0b1 : (BitVec 1))))
         then (Bool.and v1Is0 v2Is0)
         else if (Bool.and (BEq.beq s1 (0b1 : (BitVec 1))) (BEq.beq s2 (0b0 : (BitVec 1))))
              then true
              else if (BEq.beq e1 e2)
                   then (GE.ge (BitVec.toNat m1) (BitVec.toNat m2))
                   else (GT.gt (BitVec.toNat e1) (BitVec.toNat e2))
  let fflags :=
    if is_quiet
    then if (Bool.or (f_is_SNaN_H v1) (f_is_SNaN_H v2))
         then (nvFlag ())
         else (zeros_implicit)
    else if (Bool.or (f_is_NaN_H v1) (f_is_NaN_H v2))
         then (nvFlag ())
         else (zeros_implicit)
  (result, fflags)

