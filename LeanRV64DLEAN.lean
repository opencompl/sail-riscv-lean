def fence_bits_forwards (arg_ : (BitVec 4)) : String :=
  match arg_ with
  | v__0 =>
    let i : (BitVec 1) := (Sail.BitVec.extractLsbUnif v__0 3 3)
    let w : (BitVec 1) := (Sail.BitVec.extractLsbUnif v__0 0 0)
    let r : (BitVec 1) := (Sail.BitVec.extractLsbUnif v__0 1 1)
    let o : (BitVec 1) := (Sail.BitVec.extractLsbUnif v__0 2 2)
    let i : (BitVec 1) := (Sail.BitVec.extractLsbUnif v__0 3 3)
    (String.append (bit_maybe_i_forwards i)
      (String.append (bit_maybe_o_forwards o)
        (String.append (bit_maybe_r_forwards r) (String.append (bit_maybe_w_forwards w) ""))))

