/-- Type quantifiers: n : Nat, n ∈ {16, 32, 64, 128} -/
def canonical_NaN {n : _} : (BitVec n) :=
  match (__id n) with
  | 16 =>
    (Sail.BitVec.append' (0b0 : (BitVec 1))
      (Sail.BitVec.append' (ones) (Sail.BitVec.append' (0b1 : (BitVec 1)) (zeros_implicit))))
  | 32 =>
    (Sail.BitVec.append' (0b0 : (BitVec 1))
      (Sail.BitVec.append' (ones) (Sail.BitVec.append' (0b1 : (BitVec 1)) (zeros_implicit))))
  | 64 =>
    (Sail.BitVec.append' (0b0 : (BitVec 1))
      (Sail.BitVec.append' (ones) (Sail.BitVec.append' (0b1 : (BitVec 1)) (zeros_implicit))))
  | _ =>
    (Sail.BitVec.append' (0b0 : (BitVec 1))
      (Sail.BitVec.append' (ones) (Sail.BitVec.append' (0b1 : (BitVec 1)) (zeros_implicit))))

def canonical_NaN_H (_ : Unit) : (BitVec 16) :=
  (canonical_NaN)

def canonical_NaN_S (_ : Unit) : (BitVec 32) :=
  (canonical_NaN)

def canonical_NaN_D (_ : Unit) : (BitVec 64) :=
  (canonical_NaN)

def canonical_NaN_Q (_ : Unit) : (BitVec 128) :=
  (canonical_NaN)

/-- Type quantifiers: k_n : Int, n : Int, k_n ≤ n -/
def nan_box {n : _} (x : (BitVec k_n)) : (BitVec n) :=
  (Sail.BitVec.append' (ones) x)

/-- Type quantifiers: k_n : Nat, m : Nat, m ∈ {16, 32, 64, 128} ∧ k_n ≥ m -/
def nan_unbox {m : _} (x : (BitVec k_n)) : (BitVec m) :=
  if (BEq.beq (Sail.BitVec.length x) (__id m))
  then x
  else if (BEq.beq (Sail.BitVec.extractLsbUnif x (HSub.hSub (Sail.BitVec.length x) 1) (__id m))
            (ones))
       then (Sail.BitVec.extractLsbUnif x (HSub.hSub (__id m) 1) 0)
       else (canonical_NaN)

def dirty_fd_context (_ : Unit) : SailM Unit := do
  assert (sys_enable_fdext ()) "riscv_fdext_regs.sail:89.27-89.28"
  writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus) 14 13 (extStatus_to_bits Dirty))
  writeReg mstatus (Sail.BitVec.updateSubrange (← readReg mstatus)
    (HSub.hSub (HMul.hMul ((2 ^ ·) 3) 8) 1) (HSub.hSub (HMul.hMul ((2 ^ ·) 3) 8) 1)
    (0b1 : (BitVec 1)))

def dirty_fd_context_if_present (_ : Unit) : SailM Unit := do
  assert (neq_bool (sys_enable_fdext ()) (sys_enable_zfinx ())) "riscv_fdext_regs.sail:95.49-95.50"
  if (sys_enable_fdext ())
  then (dirty_fd_context ())
  else (pure ())

