def fsplit_H (xf16 : (BitVec 16)) : ((BitVec 1) × (BitVec 5) × (BitVec 10)) :=
  ((Sail.BitVec.extractLsbUnif xf16 15 15), (Sail.BitVec.extractLsbUnif xf16 14 10), (Sail.BitVec.extractLsbUnif
    xf16 9 0))

def fmake_H (sign : (BitVec 1)) (exp : (BitVec 5)) (mant : (BitVec 10)) : (BitVec 16) :=
  (Sail.BitVec.append' sign (Sail.BitVec.append' exp mant))

def negate_H (xf16 : (BitVec 16)) : (BitVec 16) :=
  let (sign, exp, mant) := (fsplit_H xf16)
  let new_sign :=
    if (BEq.beq sign (0b0 : (BitVec 1)))
    then (0b1 : (BitVec 1))
    else (0b0 : (BitVec 1))
  (fmake_H new_sign exp mant)

def f_is_neg_inf_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (0b1 : (BitVec 1)))
    (Bool.and (BEq.beq exp (ones)) (BEq.beq mant (zeros_implicit))))

def f_is_neg_norm_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (0b1 : (BitVec 1))) (Bool.and (bne exp (zeros_implicit)) (bne exp (ones))))

def f_is_neg_subnorm_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (0b1 : (BitVec 1)))
    (Bool.and (BEq.beq exp (zeros_implicit)) (bne mant (zeros_implicit))))

def f_is_pos_subnorm_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (zeros_implicit))
    (Bool.and (BEq.beq exp (zeros_implicit)) (bne mant (zeros_implicit))))

def f_is_pos_norm_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (zeros_implicit)) (Bool.and (bne exp (zeros_implicit)) (bne exp (ones))))

def f_is_pos_inf_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (zeros_implicit))
    (Bool.and (BEq.beq exp (ones)) (BEq.beq mant (zeros_implicit))))

def f_is_neg_zero_H (xf16 : (BitVec 16)) : Bool :=
  let (sign, exp, mant) := (fsplit_H xf16)
  (Bool.and (BEq.beq sign (ones))
    (Bool.and (BEq.beq exp (zeros_implicit)) (BEq.beq mant (zeros_implicit))))

def f_is_pos_zero_H (xf16 : (BitVec 16)) : Bool :=
