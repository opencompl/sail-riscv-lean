def ext_write_vcsr (vxrm_val : (BitVec 2)) (vxsat_val : (BitVec 1)) : SailM Unit := do
  writeReg vcsr (Sail.BitVec.updateSubrange (← readReg vcsr) 2 1 vxrm_val)
  writeReg vcsr (Sail.BitVec.updateSubrange (← readReg vcsr) 0 0 vxsat_val)
  (dirty_v_context ())

/-- Type quantifiers: SEW : Int, LMUL_pow : Int -/
def get_num_elem (LMUL_pow : Int) (SEW : Int) : SailM Int := do
  let LMUL_pow_reg :=
    if (LT.lt LMUL_pow 0)
    then 0
    else LMUL_pow
  let num_elem := (Int.tdiv (HMul.hMul ((2 ^ ·) LMUL_pow_reg) VLEN) SEW)
  assert (GT.gt num_elem 0) "riscv_vext_regs.sail:231.21-231.22"
  (pure num_elem)

/-- Type quantifiers: num_elem : Nat, SEW : Nat, num_elem ≥ 0 ∧ SEW ≥ 0 -/
def read_single_vreg (num_elem : Nat) (SEW : Nat) (vrid : (BitVec 5)) : SailM (Vector (BitVec SEW) num_elem) := do
  let bv : vregtype ← do (rV_bits vrid)
  let result : (Vector (BitVec SEW) num_elem) := (vectorInit (zeros_implicit))
  assert (Bool.and (LE.le 8 SEW) (LE.le SEW 64)) "riscv_vext_regs.sail:241.29-241.30"
  let loop_i_lower := 0
  let loop_i_upper := (HSub.hSub num_elem 1)
  (pure (foreach_ loop_i_lower loop_i_upper 1 result
      (λ i result =>
        let start_index := (HMul.hMul i SEW)
        (vectorUpdate result i (slice bv start_index SEW)))))

/-- Type quantifiers: num_elem : Nat, SEW : Int, num_elem ≥ 0 -/
def write_single_vreg (num_elem : Nat) (SEW : Int) (vrid : (BitVec 5)) (v : (Vector (BitVec SEW) num_elem)) : SailM Unit := do
  let r : vregtype := (zeros_implicit)
  assert (Bool.and (LE.le 8 SEW) (LE.le SEW 64)) "riscv_vext_regs.sail:255.29-255.30"
  let r : (BitVec 65536) :=
    let loop_i_lower := 0
    let loop_i_upper := (HSub.hSub num_elem 1)
    foreach_ loop_i_upper loop_i_lower 1 r
      (λ i r =>
        let r : vregtype := (shiftl r SEW)
        (HOr.hOr r (zero_extend (vectorAccess v i))))
  (wV_bits vrid r)

/-- Type quantifiers: num_elem : Nat, SEW : Nat, LMUL_pow : Int, num_elem ≥ 0 ∧ SEW ≥ 0 -/
def read_vreg (num_elem : Nat) (SEW : Nat) (LMUL_pow : Int) (vrid : (BitVec 5)) : SailM (Vector (BitVec SEW) num_elem) := do
  let result : (Vector (BitVec SEW) num_elem) := (vectorInit (zeros_implicit))
  let LMUL_pow_reg :=
    if (LT.lt LMUL_pow 0)
    then 0
    else LMUL_pow
  if (GT.gt (HAdd.hAdd (BitVec.toNat vrid) ((2 ^ ·) LMUL_pow_reg)) 32)
  then assert false "invalid register group: vrid overflow the largest number"
       throw Error.Exit
  else if (bne (emod_int (BitVec.toNat vrid) ((2 ^ ·) LMUL_pow_reg)) 0)
       then assert false "invalid register group: vrid is not a multiple of EMUL"
            throw Error.Exit
       else if (LT.lt LMUL_pow 0)
            then (read_single_vreg (length result) SEW vrid)
            else let num_elem_single := (Int.tdiv VLEN SEW)
                 assert (GE.ge (__id num_elem_single) 0) "riscv_vext_regs.sail:282.34-282.35"
                 let loop_i_lmul_lower := 0
                 let loop_i_lmul_upper := (HSub.hSub ((2 ^ ·) LMUL_pow_reg) 1)
                 foreach_M loop_i_lmul_lower loop_i_lmul_upper 1 result
                   (λ i_lmul result => do
                     let r_start_i : Int := (HMul.hMul i_lmul (__id num_elem_single))
                     let r_end_i : Int := (HSub.hSub (HAdd.hAdd r_start_i (__id num_elem_single)) 1)
                     let vrid_lmul : regidx := (HAdd.hAdd vrid (to_bits 5 i_lmul))
                     let single_result : (Vector (BitVec SEW) num_elem_single) ← do
                       (read_single_vreg (__id num_elem_single) SEW vrid_lmul)
                     let loop_r_i_lower := r_start_i
                     let loop_r_i_upper := r_end_i
                     foreach_M loop_r_i_lower loop_r_i_upper 1 result
                       (λ r_i result => do
                         let s_i : Int := (HSub.hSub r_i r_start_i)
                         assert (Bool.and (LE.le 0 r_i) (LT.lt r_i num_elem)) "riscv_vext_regs.sail:290.42-290.43"
                         assert (Bool.and (LE.le 0 s_i) (LT.lt s_i (__id num_elem_single))) "riscv_vext_regs.sail:291.50-291.51"
                         (pure (vectorUpdate result r_i (vectorAccess single_result s_i)))))

/-- Type quantifiers: EEW : Nat, index : Int, 8 ≤ EEW ∧ EEW ≤ 128 -/
def read_single_element (EEW : Nat) (index : Int) (vrid : (BitVec 5)) : SailM (BitVec EEW) := do
  assert (GE.ge VLEN EEW) "riscv_vext_regs.sail:304.20-304.21"
  let elem_per_reg := (Int.tdiv VLEN EEW)
  assert (GE.ge (__id elem_per_reg) 0) "riscv_vext_regs.sail:306.27-306.28"
  let real_vrid : regidx := (HAdd.hAdd vrid (to_bits 5 (Int.tdiv index (__id elem_per_reg))))
  let real_index : Int := (emod_int index (__id elem_per_reg))
  let vrid_val : (Vector (BitVec EEW) elem_per_reg) ← do
    (read_single_vreg (__id elem_per_reg) EEW real_vrid)
  assert (Bool.and (LE.le 0 real_index) (LT.lt real_index (__id elem_per_reg))) "riscv_vext_regs.sail:310.53-310.54"
  (pure (vectorAccess vrid_val real_index))

/-- Type quantifiers: num_elem : Nat, SEW : Nat, LMUL_pow : Int, num_elem ≥ 0 ∧ SEW ≥ 0 -/
def write_vreg (num_elem : Nat) (SEW : Nat) (LMUL_pow : Int) (vrid : (BitVec 5)) (vec : (Vector (BitVec SEW) num_elem)) : SailM Unit := do
  let LMUL_pow_reg :=
    if (LT.lt LMUL_pow 0)
    then 0
    else LMUL_pow
  let num_elem_single := (Int.tdiv VLEN SEW)
  assert (GE.ge (__id num_elem_single) 0) "riscv_vext_regs.sail:320.30-320.31"
  let loop_i_lmul_lower := 0
  let loop_i_lmul_upper := (HSub.hSub ((2 ^ ·) LMUL_pow_reg) 1)
  foreach_M loop_i_lmul_lower loop_i_lmul_upper 1 ()
    (λ i_lmul _ => do
      let single_vec : (Vector (BitVec SEW) num_elem_single) := (vectorInit (zeros_implicit))
      let vrid_lmul : regidx := (HAdd.hAdd vrid (to_bits 5 i_lmul))
      let r_start_i : Int := (HMul.hMul i_lmul (__id num_elem_single))
      let r_end_i : Int := (HSub.hSub (HAdd.hAdd r_start_i (__id num_elem_single)) 1)
      let single_vec : (Vector (BitVec SEW) num_elem_single) ← do
        let loop_r_i_lower := r_start_i
        let loop_r_i_upper := r_end_i
        foreach_M loop_r_i_lower loop_r_i_upper 1 single_vec
          (λ r_i single_vec => do
            let s_i : Int := (HSub.hSub r_i r_start_i)
            assert (Bool.and (LE.le 0 r_i) (LT.lt r_i num_elem)) "riscv_vext_regs.sail:328.38-328.39"
            assert (Bool.and (LE.le 0 s_i) (LT.lt s_i (__id num_elem_single))) "riscv_vext_regs.sail:329.46-329.47"
            (pure (vectorUpdate single_vec s_i (vectorAccess vec r_i))))
      (write_single_vreg (__id num_elem_single) SEW vrid_lmul single_vec))

/-- Type quantifiers: EEW : Nat, index : Int, 8 ≤ EEW ∧ EEW ≤ 128 -/
def write_single_element (EEW : Nat) (index : Int) (vrid : (BitVec 5)) (value : (BitVec EEW)) : SailM Unit := do
  let elem_per_reg := (Int.tdiv VLEN EEW)
  assert (GE.ge (__id elem_per_reg) 0) "riscv_vext_regs.sail:340.27-340.28"
  let real_vrid : regidx := (HAdd.hAdd vrid (to_bits 5 (Int.tdiv index (__id elem_per_reg))))
  let real_index : Int := (emod_int index (__id elem_per_reg))
  let vrid_val : (Vector (BitVec EEW) elem_per_reg) ← do
    (read_single_vreg (__id elem_per_reg) EEW real_vrid)
  let r : vregtype := (zeros_implicit)
  let r : (BitVec 65536) :=
    let loop_i_lower := 0
    let loop_i_upper := (HSub.hSub (__id elem_per_reg) 1)
    foreach_ loop_i_upper loop_i_lower 1 r
      (λ i r =>
        let r : vregtype := (shiftl r EEW)
        if (BEq.beq i real_index)
        then (HOr.hOr r (zero_extend value))
        else (HOr.hOr r (zero_extend (vectorAccess vrid_val i))))
  (wV_bits real_vrid r)

/-- Type quantifiers: num_elem : Nat, num_elem > 0 -/
def read_vmask (num_elem : Nat) (vm : (BitVec 1)) (vrid : (BitVec 5)) : SailM (BitVec num_elem) := do
  assert (LE.le num_elem 65536) "riscv_vext_regs.sail:360.36-360.37"
  let vreg_val : vregtype ← do (rV_bits vrid)
  let result : (BitVec num_elem) := (ones)
  if (BEq.beq vm (0b1 : (BitVec 1)))
  then (pure result)
  else let loop_i_lower := 0
       let loop_i_upper := (HSub.hSub num_elem 1)
       (pure (foreach_ loop_i_lower loop_i_upper 1 result
           (λ i result => (BitVec.update result i (BitVec.access vreg_val i)))))

/-- Type quantifiers: num_elem : Nat, num_elem > 0 -/
def read_vmask_carry (num_elem : Nat) (vm : (BitVec 1)) (vrid : (BitVec 5)) : SailM (BitVec num_elem) := do
  assert (LE.le num_elem 65536) "riscv_vext_regs.sail:378.36-378.37"
  let vreg_val : vregtype ← do (rV_bits vrid)
  let result : (BitVec num_elem) := (zeros_implicit)
  if (BEq.beq vm (0b1 : (BitVec 1)))
  then (pure result)
  else let loop_i_lower := 0
       let loop_i_upper := (HSub.hSub num_elem 1)
       (pure (foreach_ loop_i_lower loop_i_upper 1 result
           (λ i result => (BitVec.update result i (BitVec.access vreg_val i)))))

/-- Type quantifiers: num_elem : Nat, num_elem > 0 -/
def write_vmask (num_elem : Nat) (vrid : (BitVec 5)) (v : (BitVec num_elem)) : SailM Unit := do
  assert (Bool.and (LT.lt 0 VLEN) (LE.le VLEN 65536)) "riscv_vext_regs.sail:396.43-396.44"
  assert (Bool.and (LT.lt 0 num_elem) (LE.le num_elem VLEN)) "riscv_vext_regs.sail:397.40-397.41"
  let vreg_val : vregtype ← do (rV_bits vrid)
  let result : vregtype ← do (undefined_bitvector 65536)
  let result : (BitVec 65536) :=
    let loop_i_lower := 0
    let loop_i_upper := (HSub.hSub num_elem 1)
    foreach_ loop_i_lower loop_i_upper 1 result
      (λ i result => (BitVec.update result i (BitVec.access v i)))
  let result : (BitVec 65536) :=
    let loop_i_lower := num_elem
    let loop_i_upper := (HSub.hSub VLEN 1)
    foreach_ loop_i_lower loop_i_upper 1 result
      (λ i result => (BitVec.update result i (BitVec.access vreg_val i)))
  (wV_bits vrid result)

