                                              (HAppend.hAppend "CSR vl <- "
                                                (BitVec.toFormatted (← readReg vl)))))
                                          true)))))
             else (pure (cont (let loop_j_lower := 0
                      let loop_j_upper := (HSub.hSub nf 1)
                      foreach_M loop_j_lower loop_j_upper 1 ()
                        (λ j _ => do
                          let skipped_elem :=
                            (Sail.BitVec.extractLsbUnif
                              (shiftr (vectorAccess result i)
                                (HMul.hMul (HMul.hMul j load_width_bytes) 8))
                              (HSub.hSub (HMul.hMul load_width_bytes 8) 1) 0)
                          (write_single_element (HMul.hMul load_width_bytes 8) i
                            (HAdd.hAdd vd (to_bits 5 (HMul.hMul j EMUL_reg))) skipped_elem))
                      trimmed)))
        else (pure (cont (if (BEq.beq tail_ag AGNOSTIC)
                 then let loop_j_lower := 0
                      let loop_j_upper := (HSub.hSub nf 1)
                      foreach_M loop_j_lower loop_j_upper 1 ()
                        (λ j _ => do
                          let skipped_elem :=
                            (Sail.BitVec.extractLsbUnif
                              (shiftr (vectorAccess vd_seg i)
                                (HMul.hMul (HMul.hMul j load_width_bytes) 8))
                              (HSub.hSub (HMul.hMul load_width_bytes 8) 1) 0)
                          (write_single_element (HMul.hMul load_width_bytes 8) i
                            (HAdd.hAdd vd (to_bits 5 (HMul.hMul j EMUL_reg))) skipped_elem))
                 else (pure ())
                 trimmed)))))
  (set_vstart (zeros_implicit))
  (pure RETIRE_SUCCESS)

