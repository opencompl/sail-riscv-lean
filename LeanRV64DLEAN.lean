  let result : (BitVec num_elem) ← do (undefined_bitvector (Sail.BitVec.length vm_val))
  let real_num_elem :=
    if (GE.ge LMUL_pow 0)
    then num_elem
    else (Int.tdiv num_elem ((2 ^ ·) (HSub.hSub 0 LMUL_pow)))
  assert (GE.ge num_elem real_num_elem) "riscv_insts_vext_utils.sail:335.34-335.35"
  let (mask, result) :=
    let loop_i_lower := 0
    let loop_i_upper := (HSub.hSub num_elem 1)
    foreach_ loop_i_lower loop_i_upper 1 (mask, result)
      (λ i (mask, result) =>
        let (mask, result) :=
          if (LT.lt i start_element)
          then let result : (BitVec num_elem) := (BitVec.update result i (BitVec.access vd_val i))
               let mask : (BitVec num_elem) := (BitVec.update mask i 0#1)
               (mask, result)
          else let (mask, result) :=
                 if (GT.gt i end_element)
                 then let result : (BitVec num_elem) :=
                        (BitVec.update result i (BitVec.access vd_val i))
                      let mask : (BitVec num_elem) := (BitVec.update mask i 0#1)
                      (mask, result)
                 else let (mask, result) :=
                        if (GE.ge i real_num_elem)
                        then let result : (BitVec num_elem) :=
                               (BitVec.update result i (BitVec.access vd_val i))
                             let mask : (BitVec num_elem) := (BitVec.update mask i 0#1)
                             (mask, result)
                        else let (mask, result) :=
                               if (BEq.beq (BitVec.access vm_val i) 0#1)
                               then let result : (BitVec num_elem) :=
                                      (BitVec.update result i
                                        (match mask_ag with
                                        | UNDISTURBED => (BitVec.access vd_val i)
                                        | AGNOSTIC => (BitVec.access vd_val i)))
                                    let mask : (BitVec num_elem) := (BitVec.update mask i 0#1)
                                    (mask, result)
                               else let mask : (BitVec num_elem) := (BitVec.update mask i 1#1)
                                    (mask, result)
                             (mask, result)
                      (mask, result)
               (mask, result)
        (mask, result))
  (pure (result, mask))

/-- Type quantifiers: num_elem : Nat, SEW : Nat, LMUL_pow : Int, nf : Nat, num_elem ≥ 0 ∧
  SEW ≥ 0 ∧ nf ≥ 0 -/
def read_vreg_seg (num_elem : Nat) (SEW : Nat) (LMUL_pow : Int) (nf : Nat) (vrid : (BitVec 5)) : SailM (Vector (BitVec (nf * SEW)) num_elem) := do
  let LMUL_reg : Int :=
    if (LE.le LMUL_pow 0)
    then 1
    else ((2 ^ ·) LMUL_pow)
  let vreg_list : (Vector (Vector (BitVec SEW) num_elem) nf) :=
    (vectorInit (vectorInit (zeros_implicit)))
  let result : (Vector (BitVec (nf * SEW)) num_elem) := (vectorInit (zeros_implicit))
  let vreg_list : (Vector (Vector (BitVec SEW) num_elem) nf) ← do
    let loop_j_lower := 0
    let loop_j_upper := (HSub.hSub nf 1)
    foreach_M loop_j_lower loop_j_upper 1 vreg_list
      (λ j vreg_list => do
        (pure (vectorUpdate vreg_list j
            (← (read_vreg num_elem SEW LMUL_pow
                (HAdd.hAdd vrid (to_bits 5 (HMul.hMul j LMUL_reg))))))))
  let loop_i_lower := 0
  let loop_i_upper := (HSub.hSub num_elem 1)
  (pure (foreach_ loop_i_lower loop_i_upper 1 result
      (λ i result =>
        let result : (Vector (BitVec (nf * SEW)) num_elem) :=
          (vectorUpdate result i (zeros_implicit))
        let loop_j_lower := 0
        let loop_j_upper := (HSub.hSub nf 1)
        foreach_ loop_j_lower loop_j_upper 1 result
          (λ j result =>
            (vectorUpdate result i
              (HOr.hOr (vectorAccess result i)
                (shiftl (zero_extend (vectorAccess (vectorAccess vreg_list j) i))
                  (HMul.hMul j (__id SEW)))))))))

/-- Type quantifiers: k_n : Nat, SEW : Nat, 0 ≤ k_n ∧ SEW ∈ {8, 16, 32, 64} -/
def get_shift_amount (bit_val : (BitVec k_n)) (SEW : Nat) : SailM Nat := do
  let lowlog2bits := (log2 SEW)
  assert (Bool.and (LT.lt 0 lowlog2bits) (LT.lt lowlog2bits (Sail.BitVec.length bit_val))) "riscv_insts_vext_utils.sail:393.43-393.44"
  (pure (BitVec.toNat (Sail.BitVec.extractLsbUnif bit_val (HSub.hSub lowlog2bits 1) 0)))

/-- Type quantifiers: k_m : Nat, shift_amount : Nat, k_m > 0 ∧ shift_amount ≥ 0 -/
def get_fixed_rounding_incr (vec_elem : (BitVec k_m)) (shift_amount : Nat) : SailM (BitVec 1) := do
  if (BEq.beq shift_amount 0)
  then (pure (0b0 : (BitVec 1)))
  else let rounding_mode ← do (pure (_get_Vcsr_vxrm (← readReg vcsr)))
       let b__0 := rounding_mode
       if (BEq.beq b__0 (0b00 : (BitVec 2)))
       then (pure (slice vec_elem (HSub.hSub shift_amount 1) 1))
       else if (BEq.beq b__0 (0b01 : (BitVec 2)))
            then (pure (bool_to_bits
                     (Bool.and
                       (BEq.beq (slice vec_elem (HSub.hSub shift_amount 1) 1) (0b1 : (BitVec 1)))
                       (Bool.or (bne (slice vec_elem 0 (HSub.hSub shift_amount 1)) (zeros_implicit))
                         (BEq.beq (slice vec_elem shift_amount 1) (0b1 : (BitVec 1)))))))
            else if (BEq.beq b__0 (0b10 : (BitVec 2)))
                 then (pure (0b0 : (BitVec 1)))
                 else (pure (bool_to_bits
                          (Bool.and
                            (not (BEq.beq (slice vec_elem shift_amount 1) (0b1 : (BitVec 1))))
                            (bne (slice vec_elem 0 shift_amount) (zeros_implicit)))))

/-- Type quantifiers: len : Nat, k_n : Nat, k_n ≥ len ∧ len > 1 -/
def unsigned_saturation (len : Nat) (elem : (BitVec k_n)) : SailM (BitVec len) := do
  if (GT.gt (BitVec.toNat elem) (BitVec.toNat (ones)))
  then writeReg vcsr (Sail.BitVec.updateSubrange (← readReg vcsr) 0 0 (0b1 : (BitVec 1)))
       (pure (ones))
  else (pure (Sail.BitVec.extractLsbUnif elem (HSub.hSub (__id len) 1) 0))

/-- Type quantifiers: len : Nat, k_n : Nat, k_n ≥ len ∧ len > 1 -/
def signed_saturation (len : Nat) (elem : (BitVec k_n)) : SailM (BitVec len) := do
  if (GT.gt (BitVec.toInt elem) (BitVec.toInt (Sail.BitVec.append' (0b0 : (BitVec 1)) (ones))))
  then writeReg vcsr (Sail.BitVec.updateSubrange (← readReg vcsr) 0 0 (0b1 : (BitVec 1)))
       (pure (Sail.BitVec.append' (0b0 : (BitVec 1)) (ones)))
  else if (LT.lt (BitVec.toInt elem)
            (BitVec.toInt (Sail.BitVec.append' (0b1 : (BitVec 1)) (zeros_implicit))))
       then writeReg vcsr (Sail.BitVec.updateSubrange (← readReg vcsr) 0 0 (0b1 : (BitVec 1)))
            (pure (Sail.BitVec.append' (0b1 : (BitVec 1)) (zeros_implicit)))
       else (pure (Sail.BitVec.extractLsbUnif elem (HSub.hSub (__id len) 1) 0))

/-- Type quantifiers: len : Int -/
def count_leadingzeros (sig : (BitVec 64)) (len : Int) : SailM Int := do
  let idx : Int := (-1)
  assert (Bool.or (BEq.beq len 10) (Bool.or (BEq.beq len 23) (BEq.beq len 52))) "riscv_insts_vext_utils.sail:442.42-442.43"
  let idx : Int :=
    let loop_i_lower := 0
    let loop_i_upper := (HSub.hSub len 1)
    foreach_ loop_i_lower loop_i_upper 1 idx
      (λ i idx =>
        if (BEq.beq (BitVec.access sig i) 1#1)
        then i
        else idx)
  (pure (HSub.hSub (HSub.hSub len idx) 1))

/-- Type quantifiers: SEW : Nat, SEW ∈ {8, 16, 32, 64} -/
def valid_fp_op (SEW : Nat) (rm_3b : (BitVec 3)) : Bool :=
  let valid_sew := (Bool.and (GE.ge SEW 16) (LE.le SEW 128))
  let valid_rm :=
    (not
      (Bool.or (BEq.beq rm_3b (0b101 : (BitVec 3)))
        (Bool.or (BEq.beq rm_3b (0b110 : (BitVec 3))) (BEq.beq rm_3b (0b111 : (BitVec 3))))))
  (Bool.and valid_sew valid_rm)

