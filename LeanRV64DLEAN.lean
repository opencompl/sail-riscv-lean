def process_clean_inval (rs1 : (BitVec 5)) (cbop : cbop_zicbom) : SailM Retired := do
  let rs1_val ← do (rX_bits rs1)
  let cache_block_size_exp := (plat_cache_block_size_exp ())
  let cache_block_size := ((2 ^ ·) cache_block_size_exp)
  let negative_offset :=
    (HSub.hSub (HAnd.hAnd rs1_val (Complement.complement (zero_extend (ones)))) rs1_val)
  match (← (ext_data_get_addr rs1 negative_offset (Read Data) cache_block_size)) with
  | .Ext_DataAddr_Error e =>
    let _ := (ext_handle_data_check_error e)
    (pure RETIRE_FAIL)
  | .Ext_DataAddr_OK vaddr =>
    let res : (Option ExceptionType) ← do
      match (← (translateAddr vaddr (Read Data))) with
      | .TR_Address (paddr, _) =>
        let exc_read ← do
          (phys_access_check (Read Data) (← readReg cur_privilege) paddr cache_block_size)
        let exc_write ← do
          (phys_access_check (Write Data) (← readReg cur_privilege) paddr cache_block_size)
        match (exc_read, exc_write) with
        | (.some exc_read, .some exc_write) => (pure (some exc_write))
        | _ => (pure none)
      | .TR_Failure (e, _) => (pure (some e))
    match res with
    | none => (pure RETIRE_SUCCESS)
    | .some e =>
      let e : ExceptionType ← do
        match e with
        | .E_Load_Access_Fault () => (pure (E_SAMO_Access_Fault ()))
        | .E_SAMO_Access_Fault () => (pure (E_SAMO_Access_Fault ()))
        | .E_Load_Page_Fault () => (pure (E_SAMO_Page_Fault ()))
        | .E_SAMO_Page_Fault () => (pure (E_SAMO_Page_Fault ()))
        | _ =>
          (internal_error "riscv_insts_zicbom.sail" 91 "unexpected exception for cmo.clean/inval")
      (handle_mem_exception (sub_virtaddr_xlenbits vaddr negative_offset) e)
      (pure RETIRE_FAIL)

